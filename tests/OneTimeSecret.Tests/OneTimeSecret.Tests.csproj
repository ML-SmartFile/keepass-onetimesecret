<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OneTimeSecret.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    Core/ and Ots/ are compiled in directly rather than referenced through the plugin
    assembly. Two reasons: this project then builds and runs with no KeePass installed,
    and it enforces non-negotiable #3 at build time - a `using KeePass...` added to
    Core/ or Ots/ breaks this build immediately.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\OneTimeSecret\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\src\OneTimeSecret\Ots\**\*.cs" LinkBase="Ots" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
