<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OneTimeSecret.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <!--
    Links the same Core/ and Ots/ sources as the unit test project, for the same reason:
    this builds and runs with no KeePass installed. Unlike the unit suite, these tests
    hit a real network endpoint - see SPEC.md section 9 and README.md. Never part of
    `dotnet test tests/OneTimeSecret.Tests`; run this project directly, and only after
    setting the OTS_TEST_* environment variables described in README.md.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\OneTimeSecret\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\src\OneTimeSecret\Ots\**\*.cs" LinkBase="Ots" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
